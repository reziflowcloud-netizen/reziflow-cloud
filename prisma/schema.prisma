// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      String   @default("employee")
  avatarUrl String?
  avatarPublicId String?
  preferences Json?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  createdAt DateTime @default(now())
  cases     Case[]
  tasks     Task[]
  leads     Lead[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  status    String   @default("active")
  plan      String   @default("manual")
  trialEndsAt DateTime?
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  clients   Client[]
  cases     Case[]
  tasks     Task[]
  caseStatuses CaseStatus[]
  taskPriorities TaskPriority[]
  services  Service[]
  caseOptions CaseOption[]
  employees Employee[]
  uiSectionSettings UiSectionSetting[]
  customSections CustomSection[]
  customFieldValues CustomFieldValue[]
  clientFamilyLinks ClientFamilyLink[]
  documentTemplates DocumentTemplate[]
  leads     Lead[]
  leadStatuses LeadStatus[]
}

model LeadStatus {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("#2563eb")
  order          Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, order])
}

model Lead {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  assignedToId   Int?
  assignedTo     User?         @relation(fields: [assignedToId], references: [id])
  convertedClientId String?
  status         String        @default("Новый")
  source         String        @default("manual")
  firstName      String?
  lastName       String?
  fullName       String?
  phone          String?
  email          String?
  instagram      String?
  facebook       String?
  messengerId    String?
  city           String?
  country        String?
  language       String?
  serviceInterest String?
  budget         String?
  urgency        String?
  notes          String?
  lastContactAt  DateTime?
  lastContactNote String?
  nextContactAt  DateTime?
  nextContactNote String?
  convertedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, source])
  @@index([organizationId, assignedToId])
}

model DocumentTemplate {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  name           String
  fileName       String
  mimeType       String
  content        Bytes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, type])
}

model UiSectionSetting {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String
  sectionKey     String
  visible        Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, scope, sectionKey])
  @@index([organizationId])
}

model CustomSection {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String
  title          String
  description    String?
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  fields         CustomField[]

  @@index([organizationId, scope])
}

model CustomField {
  id          Int          @id @default(autoincrement())
  sectionId   Int
  section     CustomSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label       String
  type        String       @default("text")
  placeholder String?
  options     Json?
  required    Boolean      @default(false)
  active      Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  values      CustomFieldValue[]

  @@index([sectionId])
}

model CustomFieldValue {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldId        Int
  field          CustomField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recordType     String
  recordId       String
  value          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([fieldId, recordType, recordId])
  @@index([organizationId, recordType, recordId])
}

model Client {
  id                String    @id @default(cuid())
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  firstName         String
  lastName          String
  phone             String?
  email             String?
  city              String?
  pesel             String?
  passportSeries    String?
  passportNumber    String?
  passportIssuedBy  String?
  passportIssuedAt  DateTime?
  passportExpiresAt DateTime?
  addressInPoland   String?
  originCountryAddress String?
  previousResidenceAddress String?
  stayBasis         String?
  motherMaidenName  String?
  dependents        String?
  height            String?
  eyeColor          String?
  specialSigns      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  cases             Case[]
  previousFirstName  String?
  previousLastName   String?
  maidenName         String?
  birthDate          DateTime?
  birthPlace         String?
  citizenship        String?
  nationality        String?
  maritalStatus      String?
  education          String?
  statusUKR          Boolean @default(false)
  fatherName         String?
  motherName         String?
  branch             String?
  legalTitle         String?
  rentalEndDate      DateTime?
  lastEntryDate      DateTime?
  firstResidenceCard Boolean @default(false)
  residenceCardExpiry DateTime?
  finesInPoland      Boolean @default(false)
  finesDescription   String?
  travelHistory      TravelHistory[]
  familyLinks         ClientFamilyLink[] @relation("ClientFamilySource")
  familyLinkedBy      ClientFamilyLink[] @relation("ClientFamilyRelative")
}

model ClientFamilyLink {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client       @relation("ClientFamilySource", fields: [clientId], references: [id], onDelete: Cascade)
  relativeClientId String
  relativeClient   Client       @relation("ClientFamilyRelative", fields: [relativeClientId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@unique([clientId, relativeClientId])
  @@index([organizationId])
  @@index([clientId])
  @@index([relativeClientId])
}

model Case {
  id                 String          @id @default(cuid())
  organizationId     String?
  organization       Organization?   @relation(fields: [organizationId], references: [id])
  caseNumber         String?
  clientId           String
  client             Client          @relation(fields: [clientId], references: [id])
  assignedToId       Int?
  assignedTo         User?           @relation(fields: [assignedToId], references: [id])
  status             String          @default("Новый")
  stayPurpose        String?
  stayType           String?
  contractType       String?
  contractDate       DateTime?
  contractNumber     String?
  contractSigned     Boolean         @default(false)
  contractValue      Float           @default(0)
  mosNumber          String?
  mosSentAt          DateTime?
  mosSentByPost      Boolean         @default(false)
  predictedDecisionDate DateTime?
  fingerprintsDate   DateTime?
  cabinetLogin       String?
  cabinetPassword    String?
  filingDate         DateTime?
  personalAppearDate DateTime?
  legalStayDeadline  DateTime?
  totalValue         Float           @default(0)
  totalPaid          Float           @default(0)
  notes              String?
  serviceId          Int?
  service            Service?        @relation(fields: [serviceId], references: [id])
  // Новые поля
  trustee            String?
  employeeId         Int?
  employee           Employee?       @relation(fields: [employeeId], references: [id])
  workContractType   String?
  workContractNumber String?
  workContractDate   DateTime?
  workContractSigned Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  payments           Payment[]
  documents          Document[]      // старая модель — оставляем
  caseDocuments      CaseDocument[]  // новая модель для Cloudinary — переименовано!
  comments           Comment[]
  statusHistory      StatusHistory[]
  customDates        CaseCustomDate[]
  docUpdates         DocUpdate[]

  @@unique([organizationId, caseNumber])
}

model Payment {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  amount    Float
  date      DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  name      String
  url       String?
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id])
  text      String
  author    String
  createdAt DateTime @default(now())
}

model StatusHistory {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id])
  fromStatus String?
  toStatus   String
  changedBy  String
  changedAt  DateTime @default(now())
}

model Task {
  id           String    @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  title        String
  description  String?
  priority     String    @default("Нормально")
  status       String    @default("todo")
  dueDate      DateTime?
  assignedToId Int?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])
  clientName   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model CaseStatus {
  id        Int      @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name      String
  color     String   @default("#3b82f6")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([organizationId, name])
}

model TaskPriority {
  id        Int      @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name      String
  color     String   @default("#6b7280")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([organizationId, name])
}

model Service {
  id          Int      @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name        String
  description String?
  price       Float?   @default(0)
  color       String   @default("#3b82f6")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  cases       Case[]

  @@unique([organizationId, name])
}

model CaseOption {
  id        Int      @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  type      String
  value     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Employee {
  id        Int      @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  cases     Case[]
}

model CaseCustomDate {
  id     Int      @id @default(autoincrement())
  caseId String
  label  String
  date   DateTime
  case   Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model DocUpdate {
  id          Int      @id @default(autoincrement())
  caseId      String
  date        DateTime
  description String
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id        Int      @id @default(autoincrement())
  caseId    String
  url       String
  publicId  String
  name      String
  fileType  String   @default("image")
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model TravelHistory {
  id        Int       @id @default(autoincrement())
  clientId  String
  entryDate DateTime?
  exitDate  DateTime?
  country   String
  createdAt DateTime  @default(now())
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}
