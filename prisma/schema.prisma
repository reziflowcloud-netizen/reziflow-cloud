// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  password            String
  name                String
  role                String               @default("employee")
  avatarUrl           String?
  avatarPublicId      String?
  preferences         Json?
  restrictedAccess    Boolean              @default(false)
  sessionVersion      Int                  @default(0)
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  createdAt           DateTime             @default(now())
  cases               Case[]
  clients             Client[]
  tasks               Task[]
  leads               Lead[]
  leadContactHistory  LeadContactHistory[]
  leadMessages        LeadMessage[]
  metaMessageReads    MetaMessageRead[]
  employee            Employee?            @relation("EmployeeUser")
  passwordResetTokens PasswordResetToken[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  pushSubscriptions PushSubscription[]

  @@unique([id, organizationId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetRateLimit {
  id           String   @id @default(cuid())
  keyHash      String
  windowStart  DateTime
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([keyHash, windowStart])
  @@index([windowStart])
}

model Organization {
  id                    String               @id @default(cuid())
  name                  String
  slug                  String               @unique
  status                String               @default("active")
  plan                  String               @default("manual")
  billingStatus         String               @default("manual")
  billingProvider       String               @default("manual")
  billingCustomerId     String?              @unique
  billingSubscriptionId String?              @unique
  billingPriceId        String?
  trialStartedAt        DateTime?
  trialEndsAt           DateTime?
  currentPeriodEndsAt   DateTime?
  cancelAtPeriodEnd     Boolean              @default(false)
  graceEndsAt           DateTime?
  settings              Json?
  metaMessageActivatedAt DateTime @default(now())
  notificationAutomationEnabled Boolean @default(false)
  notificationAutomationActivatedAt DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  users                 User[]
  clients               Client[]
  cases                 Case[]
  tasks                 Task[]
  caseStatuses          CaseStatus[]
  taskPriorities        TaskPriority[]
  services              Service[]
  caseOptions           CaseOption[]
  employees             Employee[]
  uiSectionSettings     UiSectionSetting[]
  customSections        CustomSection[]
  customFieldValues     CustomFieldValue[]
  clientFamilyLinks     ClientFamilyLink[]
  documentTemplates     DocumentTemplate[]
  leads                 Lead[]
  leadStatuses          LeadStatus[]
  leadContactHistory    LeadContactHistory[]
  leadMessages          LeadMessage[]
  leadWebhookLogs       LeadWebhookLog[]
  metaLeadAdsBindings   MetaLeadAdsBinding[]
  metaLeadAdsDeliveries MetaLeadAdsDelivery[]
  leadPhones            LeadPhone[]
  clientPhones          ClientPhone[]
  referralAttribution   ReferralAttribution?
  referralCommissions   ReferralCommission[]
  leadChannelRoutes     LeadChannelRoute[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions PushSubscription[]

  @@index([billingStatus])
  @@index([billingProvider])
}

model ReferralPartner {
  id               String                @id @default(cuid())
  name             String
  code             String                @unique
  status           String                @default("active")
  contactEmail     String?
  commissionType   String                @default("percentage")
  commissionValue  Float                 @default(10)
  commissionMonths Int                   @default(12)
  portalToken      String?               @unique
  payoutDetails    String?
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt
  attributions     ReferralAttribution[]
  commissions      ReferralCommission[]
  payouts          ReferralPayout[]

  @@index([status])
}

model ReferralAttribution {
  id             String          @id @default(cuid())
  organizationId String          @unique
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  partnerId      String
  partner        ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  referralCode   String
  landingPath    String?
  createdAt      DateTime        @default(now())

  @@index([partnerId])
  @@index([referralCode])
}

model ReferralCommission {
  id             String          @id @default(cuid())
  partnerId      String
  partner        ReferralPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payoutId       String?
  payout         ReferralPayout? @relation(fields: [payoutId], references: [id])
  sourceType     String          @default("manual")
  sourceId       String?
  baseAmount     Float           @default(0)
  amount         Float
  currency       String          @default("PLN")
  status         String          @default("pending")
  earnedAt       DateTime        @default(now())
  payableAt      DateTime?
  paidAt         DateTime?
  canceledAt     DateTime?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  @@index([partnerId, status])
  @@index([organizationId])
  @@index([sourceType, sourceId])
}

model ReferralPayout {
  id          String               @id @default(cuid())
  partnerId   String
  partner     ReferralPartner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String               @default("PLN")
  status      String               @default("paid")
  paidAt      DateTime             @default(now())
  notes       String?
  createdAt   DateTime             @default(now())
  commissions ReferralCommission[]

  @@index([partnerId, paidAt])
}

model LeadStatus {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  color          String       @default("#2563eb")
  order          Int          @default(0)
  requireReason  Boolean      @default(false)
  reasons        Json         @default("[]")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, name])
  @@index([organizationId, order])
}

model Lead {
  id                  String               @id @default(cuid())
  organizationId      String?
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  assignedToId        Int?
  assignedTo          User?                @relation(fields: [assignedToId], references: [id])
  employeeId          Int?
  employee            Employee?            @relation(fields: [employeeId], references: [id])
  convertedClientId   String?
  status              String               @default("Новый")
  source              String               @default("manual")
  firstName           String?
  lastName            String?
  fullName            String?
  phone               String?
  email               String?
  instagram           String?
  facebook            String?
  messengerId         String?
  city                String?
  voivodeship         String?
  country             String?
  language            String?
  serviceInterest     String?
  budget              String?
  urgency             String?
  statusReason        String?
  statusReasonComment String?
  notes               String?
  deadlineAt          DateTime?
  lastContactAt       DateTime?
  lastContactNote     String?
  nextContactAt       DateTime?
  nextContactNote     String?
  convertedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  contactHistory      LeadContactHistory[]
  messages            LeadMessage[]
  metaMessageReads    MetaMessageRead[]
  webhookLogs         LeadWebhookLog[]
  phones              LeadPhone[]

  @@index([organizationId, status])
  @@index([organizationId, statusReason])
  @@index([organizationId, source])
  @@index([organizationId, assignedToId])
  @@index([organizationId, employeeId])
  @@index([organizationId, deadlineAt])
}

model LeadPhone {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  phone          String
  label          String?
  note           String?
  isPrimary      Boolean       @default(false)
  whatsapp       Boolean       @default(false)
  telegram       Boolean       @default(false)
  viber          Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([leadId])
}

model LeadWebhookLog {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  status         String
  source         String?
  payload        Json?
  error          String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([leadId])
}

// Separate Lead Ads app. No token, app secret or contact fields are persisted here.
model MetaLeadAdsBinding {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appId          String
  pageId         String
  formId         String
  enabled        Boolean               @default(false)
  mode           String                @default("off")
  activatedAt    DateTime?
  pilotLeadIds   String[]              @default([])
  deliveries     MetaLeadAdsDelivery[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([appId, pageId, formId])
  @@unique([id, organizationId])
  @@index([organizationId, enabled])
}

// Durable receipt and retry state. A shadow receipt stores an HMAC, never a raw lead ID.
model MetaLeadAdsDelivery {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bindingId      String
  binding        MetaLeadAdsBinding @relation(fields: [bindingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  appId          String
  eventFingerprint String
  leadgenId      String
  acceptedMode   String
  status         String             @default("pending")
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  leaseUntil     DateTime?
  lastErrorCode  String?
  leadId         String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([appId, eventFingerprint])
  @@index([status, nextAttemptAt])
  @@index([organizationId, status])
}

model LeadContactHistory {
  id              Int          @id @default(autoincrement())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId          String
  lead            Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId        Int?
  author          User?        @relation(fields: [authorId], references: [id])
  contactAt       DateTime     @default(now())
  note            String
  nextContactAt   DateTime?
  nextContactNote String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, leadId])
  @@index([leadId, contactAt])
}

model LeadMessage {
  id                Int          @id @default(autoincrement())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId            String
  lead              Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId          Int?
  author            User?        @relation(fields: [authorId], references: [id])
  channel           String       @default("manual")
  direction         String       @default("incoming")
  senderType        String       @default("lead")
  senderName        String?
  liveReceipt       Int?         @unique
  externalMessageId String?
  text              String
  payload           Json?
  sentAt            DateTime     @default(now())
  createdAt         DateTime     @default(now())

  @@unique([organizationId, externalMessageId])
  @@index([organizationId, liveReceipt])
  @@index([organizationId, leadId, liveReceipt])
  @@index([organizationId, sentAt])
  @@index([leadId, sentAt])
  @@index([organizationId, channel])
}

model MetaMessageRead {
  organizationId String
  userId Int
  leadId String
  throughReceipt Int @default(0)
  user User @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId, leadId])
}

model DocumentTemplate {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type           String
  name           String
  fileName       String
  mimeType       String
  content        Bytes
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([organizationId, type])
}

model UiSectionSetting {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope          String
  sectionKey     String
  visible        Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([organizationId, scope, sectionKey])
  @@index([organizationId])
}

model CustomSection {
  id               Int           @id @default(autoincrement())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scope            String
  targetSectionKey String?
  title            String
  description      String?
  active           Boolean       @default(true)
  sortOrder        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @default(now()) @updatedAt
  fields           CustomField[]

  @@index([organizationId, scope])
}

model CustomField {
  id          Int                @id @default(autoincrement())
  sectionId   Int
  section     CustomSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label       String
  type        String             @default("text")
  placeholder String?
  options     Json?
  required    Boolean            @default(false)
  active      Boolean            @default(true)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  values      CustomFieldValue[]

  @@index([sectionId])
}

model CustomFieldValue {
  id             Int          @id @default(autoincrement())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fieldId        Int
  field          CustomField  @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  recordType     String
  recordId       String
  value          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([fieldId, recordType, recordId])
  @@index([organizationId, recordType, recordId])
}

model Client {
  id                       String               @id @default(cuid())
  organizationId           String?
  organization             Organization?        @relation(fields: [organizationId], references: [id])
  assignedToId             Int?
  assignedTo               User?                @relation(fields: [assignedToId], references: [id])
  firstName                String
  lastName                 String
  phone                    String?
  email                    String?
  city                     String?
  pesel                    String?
  gender                   String?
  previousPolandBasis      String?
  previousPolandEntryDate  DateTime?
  previousPolandExitDate   DateTime?
  passportSeries           String?
  passportNumber           String?
  passportIssuedBy         String?
  passportIssuedAt         DateTime?
  passportExpiresAt        DateTime?
  addressInPoland          String?
  originCountryAddress     String?
  previousResidenceAddress String?
  stayBasis                String?
  motherMaidenName         String?
  dependents               String?
  height                   String?
  eyeColor                 String?
  specialSigns             String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  cases                    Case[]
  previousFirstName        String?
  previousLastName         String?
  maidenName               String?
  birthDate                DateTime?
  birthPlace               String?
  citizenship              String?
  nationality              String?
  maritalStatus            String?
  education                String?
  profession               String?
  statusUKR                Boolean              @default(false)
  fatherName               String?
  motherName               String?
  branch                   String?
  legalTitle               String?
  rentalEndDate            DateTime?
  lastEntryDate            DateTime?
  firstResidenceCard       Boolean              @default(false)
  residenceCardExpiry      DateTime?
  finesInPoland            Boolean              @default(false)
  finesDescription         String?
  travelHistory            TravelHistory[]
  previousPolandStays      PreviousPolandStay[]
  familyLinks              ClientFamilyLink[]   @relation("ClientFamilySource")
  familyLinkedBy           ClientFamilyLink[]   @relation("ClientFamilyRelative")
  phones                   ClientPhone[]

  @@index([organizationId, assignedToId])
}

model ClientPhone {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phone          String
  label          String?
  note           String?
  isPrimary      Boolean       @default(false)
  whatsapp       Boolean       @default(false)
  telegram       Boolean       @default(false)
  viber          Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId])
  @@index([clientId])
}

model ClientFamilyLink {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clientId         String
  client           Client       @relation("ClientFamilySource", fields: [clientId], references: [id], onDelete: Cascade)
  relativeClientId String
  relativeClient   Client       @relation("ClientFamilyRelative", fields: [relativeClientId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())

  @@unique([clientId, relativeClientId])
  @@index([organizationId])
  @@index([clientId])
  @@index([relativeClientId])
}

model Case {
  id                    String           @id @default(cuid())
  organizationId        String?
  organization          Organization?    @relation(fields: [organizationId], references: [id])
  caseNumber            String?
  clientId              String
  client                Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedToId          Int?
  assignedTo            User?            @relation(fields: [assignedToId], references: [id])
  status                String           @default("Новый")
  stayPurpose           String?
  stayType              String?
  staySubPurpose        String?
  contractType          String?
  contractDate          DateTime?
  contractNumber        String?
  contractSigned        Boolean          @default(false)
  contractValue         Float            @default(0)
  mosNumber             String?
  mosSentAt             DateTime?
  mosSentByPost         Boolean          @default(false)
  predictedDecisionDate DateTime?
  decisionReceived      Boolean          @default(false)
  fingerprintsDate      DateTime?
  cabinetLogin          String?
  cabinetPassword       String?
  mosEmail              String?
  filingDate            DateTime?
  personalAppearDate    DateTime?
  personalAppearTime    String?
  personalAppearLocation String?
  personalAppearanceNote String?
  cardPickupDate        DateTime?
  cardPickupTime        String?
  cardPickupLocation    String?
  legalStayDeadline     DateTime?
  totalValue            Float            @default(0)
  totalPaid             Float            @default(0)
  notes                 String?
  serviceId             Int?
  service               Service?         @relation(fields: [serviceId], references: [id])
  // Новые поля
  trustee               String?
  employeeId            Int?
  employee              Employee?        @relation(fields: [employeeId], references: [id])
  workContractType      String?
  workContractNumber    String?
  workContractDate      DateTime?
  workContractEndDate   DateTime?
  workContractSigned    Boolean          @default(false)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  payments              Payment[]
  documents             Document[] // старая модель — оставляем
  caseDocuments         CaseDocument[] // новая модель для Cloudinary — переименовано!
  comments              Comment[]
  statusHistory         StatusHistory[]
  customDates           CaseCustomDate[]
  docUpdates            DocUpdate[]
  checklistItems        CaseChecklistItem[]
  checklistInitializedAt DateTime?
  checklistServiceId    Int?
  checklistVersion      Int              @default(0)
  documentsReady        Boolean          @default(false)
  documentsReadyOccurrence Int           @default(0)

  @@unique([organizationId, caseNumber])
  @@index([organizationId, assignedToId])
}

model Payment {
  id            String   @id @default(cuid())
  caseId        String
  case          Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  amount        Float
  date          DateTime @default(now())
  note          String?
  specialMethod Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Document {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  name      String
  url       String?
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  caseId    String
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  text      String
  author    String
  createdAt DateTime @default(now())
}

model StatusHistory {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStatus String?
  toStatus   String
  changedBy  String
  changedAt  DateTime @default(now())
}

model Task {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  title          String
  description    String?
  priority       String        @default("Нормально")
  status         String        @default("todo")
  dueDate        DateTime?
  assignedToId   Int?
  assignedTo     User?         @relation(fields: [assignedToId], references: [id])
  clientName     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, dueDate])
}

model CaseStatus {
  id             Int           @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  color          String        @default("#3b82f6")
  order          Int           @default(0)
  createdAt      DateTime      @default(now())

  @@unique([organizationId, name])
}

model TaskPriority {
  id             Int           @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  color          String        @default("#6b7280")
  order          Int           @default(0)
  createdAt      DateTime      @default(now())

  @@unique([organizationId, name])
}

model Service {
  id             Int           @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  name           String
  description    String?
  price          Float?        @default(0)
  color          String        @default("#3b82f6")
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  cases          Case[]
  documentRequirements ServiceDocumentRequirement[]
  documentTemplateInitializedAt DateTime?
  documentTemplateVersion Int @default(0)

  @@unique([organizationId, name])
}

model CaseOption {
  id             Int           @id @default(autoincrement())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  type           String
  value          String
  order          Int           @default(0)
  createdAt      DateTime      @default(now())
}

// DocumentTemplate already describes generated DOCX files; requirements are distinct.
model ServiceDocumentRequirement {
  id        String @id @default(cuid())
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name      String
  nameKey   String
  required  Boolean @default(true)
  forMos    Boolean @default(true)
  sortOrder Int @default(0)
  active    Boolean @default(true)
  items     CaseChecklistItem[]

  @@unique([serviceId, nameKey])
}

model CaseChecklistItem {
  id          String @id @default(cuid())
  caseId      String
  case        Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  templateId  String?
  template    ServiceDocumentRequirement? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  name        String
  nameKey     String
  required    Boolean @default(true)
  forMos      Boolean @default(false)
  status      String @default("NEEDED")
  receivedAt  DateTime?
  mosSubmittedAt DateTime?
  sortOrder   Int @default(0)
  note        String?
  active      Boolean @default(true)
  outsideTemplate Boolean @default(false)
  version     Int @default(0)
  files       CaseDocument[]

  @@unique([caseId, nameKey])
  @@index([caseId, active, sortOrder])
}

model Employee {
  id                      Int                      @id @default(autoincrement())
  organizationId          String?
  organization            Organization?            @relation(fields: [organizationId], references: [id])
  userId                  Int?                     @unique
  user                    User?                    @relation("EmployeeUser", fields: [userId, organizationId], references: [id, organizationId], onDelete: Restrict)
  name                    String
  active                  Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  cases                   Case[]
  leads                   Lead[]
  leadChannelRoutes       LeadChannelRoute[]
  leadChannelRouteMembers LeadChannelRouteMember[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId, userId])
}

model LeadChannelRoute {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceKey      String
  // Compatibility mirror for the V1 application; V2 assignment reads members.
  employeeId     Int
  employee       Employee                 @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "LeadChannelRoute_employeeId_fkey")
  nextPosition   Int                      @default(0)
  members        LeadChannelRouteMember[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([organizationId, sourceKey])
  @@unique([id, organizationId])
  @@index([organizationId, employeeId])
}

model LeadChannelRouteMember {
  id             String           @id @default(cuid())
  organizationId String
  routeId        String
  route          LeadChannelRoute @relation(fields: [routeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  employeeId     Int
  employee       Employee         @relation(fields: [employeeId, organizationId], references: [id, organizationId], onDelete: Cascade)
  position       Int
  createdAt      DateTime         @default(now())

  @@unique([routeId, employeeId])
  @@unique([routeId, position])
  @@index([organizationId, employeeId])
}

model CaseCustomDate {
  id     Int      @id @default(autoincrement())
  caseId String
  label  String
  date   DateTime?
  case   Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model DocUpdate {
  id          Int      @id @default(autoincrement())
  caseId      String
  date        DateTime
  description String
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model CaseDocument {
  id                Int       @id @default(autoincrement())
  caseId            String
  url               String?
  publicId          String?
  name              String
  fileType          String    @default("image")
  storageProvider   String    @default("cloudinary")
  storageId         String?
  storagePath       String?
  dropboxStorageId  String?
  dropboxPath       String?
  dropboxSyncedAt   DateTime?
  dropboxSyncStatus String?
  dropboxSyncError  String?
  mimeType          String?
  size              Int?
  createdAt         DateTime  @default(now())
  case              Case      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  checklistItemId   String?
  checklistItem     CaseChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)

  @@index([checklistItemId])
}

model TravelHistory {
  id        Int       @id @default(autoincrement())
  clientId  String
  entryDate DateTime?
  exitDate  DateTime?
  country   String
  createdAt DateTime  @default(now())
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model PreviousPolandStay {
  id        Int       @id @default(autoincrement())
  clientId  String
  entryDate DateTime?
  exitDate  DateTime?
  basis     String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, order])
}

model Notification {
  id             String                     @id @default(cuid())
  organizationId String
  userId         Int
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  type           String
  title          String
  body           String
  entityType     String
  entityId       String
  deepLink       String
  dedupeKey      String
  inApp          Boolean                    @default(true)
  pushRequested  Boolean                    @default(false)
  readAt         DateTime?
  createdAt      DateTime                   @default(now())
  deliveries     NotificationPushDelivery[]

  @@unique([organizationId, userId, dedupeKey])
  @@unique([id, userId, organizationId])
  @@index([organizationId, userId, inApp, readAt, createdAt])
}

model NotificationPreference {
  metaMessageSound Boolean @default(false)
  id             String       @id @default(cuid())
  organizationId String
  userId         Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  scope          String       @default("mine")
  events         Json         @default("{}")
  pushEnabled    Boolean      @default(false)
  showClientName Boolean      @default(false)
  language       String       @default("uk")
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
}

model PushSubscription {
  id                    String                     @id @default(cuid())
  organizationId        String
  userId                Int
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                  User                       @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  endpointHash          String                     @unique
  encryptedSubscription String
  deviceLabel           String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  disabledAt            DateTime?
  lastFailureAt         DateTime?
  deliveries            NotificationPushDelivery[]

  @@unique([id, userId, organizationId])
  @@index([organizationId, userId, disabledAt])
}

model NotificationPushDelivery {
  id             String           @id @default(cuid())
  organizationId String
  userId         Int
  notificationId String
  subscriptionId String
  notification   Notification     @relation(fields: [notificationId, userId, organizationId], references: [id, userId, organizationId], onDelete: Cascade)
  subscription   PushSubscription @relation(fields: [subscriptionId, userId, organizationId], references: [id, userId, organizationId], onDelete: Cascade)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  leaseToken     String?
  leaseUntil     DateTime?
  deliveredAt    DateTime?
  terminalAt     DateTime?
  createdAt      DateTime         @default(now())

  @@unique([notificationId, subscriptionId])
  @@index([nextAttemptAt, deliveredAt, terminalAt, leaseUntil])
}

model ConferenceEvent {
  id                 String   @id @default(cuid())
  eventName          String
  dedupeKey          String   @unique
  anonymousSessionId String
  utmSource          String?
  utmMedium          String?
  utmCampaign        String?
  utmContent         String?
  utmTerm            String?
  language           String?
  ctaLocation        String?
  demoOrigin         String?
  metadata           Json?
  createdAt          DateTime @default(now())

  @@index([eventName, createdAt])
  @@index([anonymousSessionId, createdAt])
  @@index([utmContent, createdAt])
  @@index([language, createdAt])
}
