DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_EMAILS="admin@example.com,office@example.com"
ADMIN_PASSWORD="replace-with-secure-password"
ADMIN_NAME="Administrator"
CONFERENCE_DEMO_USER_ID=""
CONFERENCE_DEMO_ORGANIZATION_ID=""
RESEND_API_KEY=""
CONTACT_EMAIL_TO="office@legalhubcrm.com"
CONTACT_EMAIL_FROM="LegalHub CRM <notifications@legalhubcrm.com>"

# Independent notification rollout gates, all disabled by default.
NOTIFICATIONS_ENABLED="false"
NOTIFICATION_EVENTS_ENABLED="false"
# Explicit general scope; invalid/missing boundary denies all automatic events.
NOTIFICATION_EVENTS_GLOBAL_ENABLED="false"
# Canonical UTC timestamp, e.g. YYYY-MM-DDTHH:mm:ss.sssZ; never backfill earlier triggers.
NOTIFICATION_EVENTS_GLOBAL_SINCE=""
WEB_PUSH_ENABLED="false"
# Must match VERCEL_ENV (production/preview) or development locally.
PUSH_ENVIRONMENT=""
PUSH_TEST_USER_ID=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:office@legalhubcrm.com"
# 32 random bytes encoded as 64 hex chars, different per environment.
PUSH_SUBSCRIPTION_ENCRYPTION_KEY=""
# At least 32 random characters, server/scheduler only.
CRON_SECRET=""
